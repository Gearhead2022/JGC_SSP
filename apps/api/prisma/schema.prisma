// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int     @id @default(autoincrement()) @map("user_id")
  name     String  @db.VarChar(150)
  username String  @unique @db.VarChar(100)
  email    String? @unique @db.VarChar(191)
  password String  @db.VarChar(255)

  isActive Boolean @default(true) @map("is_active")

  roles UserRole[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Role {
  id          Int     @id @default(autoincrement()) @map("role_id")
  name        String  @unique @map("role_name") @db.VarChar(100)
  description String? @db.Text

  users UserRole[]

  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Permission {
  id          Int              @id @default(autoincrement()) @map("permission_id")
  code        String           @unique
  name        String           @unique @db.VarChar(100)
  description String?          @db.Text
  roles       RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Pensioner {
  id String @id @default(uuid()) @db.Uuid

  legacyPensionerId Int @unique @map("pensioner_id")

  lastName   String  @map("last_name") @db.VarChar(30)
  firstName  String  @map("first_name") @db.VarChar(40)
  middleName String? @map("middle_name") @db.VarChar(40)

  birthDate       DateTime  @map("birth_date") @db.Date
  actualPension   Decimal   @map("actual_pension") @db.Decimal(12, 2)
  contingencyDate DateTime? @map("contingency_date") @db.Date

  bankName      String? @map("bank_name") @db.VarChar(100)
  accountNumber String? @map("account_number") @db.VarChar(50)

  computationSlips ComputationSlip[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("pensioners")
}

model ComputationSlip {
  id String @id @default(uuid()) @db.Uuid

  counterNumber Int @map("counter_no")

  controlNumber String @map("ctr_no") @db.VarChar(30) // should have composite key branchname CTR-00001

  accountNumber String @map("account_no") @db.VarChar(50) // LN-2026-000123

  branchName String @map("branch_name") @db.VarChar(100)

  pensionerId String @map("pensioner_uuid") @db.Uuid

  pensioner Pensioner @relation(fields: [pensionerId], references: [id], onDelete: Restrict)

  transactionDate DateTime @map("transaction_date") @db.Date
  effectivityDate DateTime @map("effectivity_date") @db.Date

  transactionType String @map("transaction_type") @db.VarChar(30)

  status LoanStatus @default(ACTIVE)

  installment          Decimal @db.Decimal(12, 2)
  terms                Int
  supplementary        Decimal @default(0) @db.Decimal(12, 2)
  supplementaryBalance Decimal @default(0) @map("supplementary_balance") @db.Decimal(12, 2)

  principalAmount Decimal @map("principal_amount") @db.Decimal(12, 2)

  udi               Decimal @db.Decimal(12, 2)
  collectionFee     Decimal @map("collection_fee") @db.Decimal(12, 2)
  processingFee     Decimal @map("processing_fee") @db.Decimal(12, 2)
  loanProtectionFee Decimal @map("loan_protection_fee") @db.Decimal(12, 2)
  icod              Decimal @db.Decimal(12, 2)

  grossCashOut Decimal @map("gross_cash_out") @db.Decimal(12, 2)
  netCashOut   Decimal @map("net_cash_out") @db.Decimal(12, 2)
  totalCashOut Decimal @map("total_cash_out") @db.Decimal(12, 2)

  renewedFromId String? @map("renewed_from_id") @db.Uuid

  renewedFrom ComputationSlip? @relation("LoanRenewal", fields: [renewedFromId], references: [id], onDelete: Restrict)

  renewals ComputationSlip[] @relation("LoanRenewal")

  closingBalance Decimal?  @map("closing_balance") @db.Decimal(12, 2)
  closedAt       DateTime? @map("closed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  loanCollections         LoanCollection[]
  supplementaryCollection SupplementaryCollection[]

  @@unique([branchName, counterNumber])
  @@unique([branchName, controlNumber])
  @@unique([accountNumber])
  @@index([status])
  @@index([renewedFromId])
  @@index([pensionerId])
  @@index([transactionDate])
  @@index([effectivityDate])
  @@map("computation_slips")
}

enum LoanStatus {
  ACTIVE
  CLOSED
  RENEWED
  PAID
  CANCELLED
}

model LoanCollection {
  id String @id @default(uuid()) @db.Uuid

  computationSlipId String @map("computation_slip_id") @db.Uuid

  computationSlip ComputationSlip @relation(fields: [computationSlipId], references: [id], onDelete: Restrict)

  collectionDate DateTime @map("collection_date") @db.Date

  amount Decimal @db.Decimal(12, 2)

  beginningBalance Decimal @map("beginning_balance") @db.Decimal(12, 2)
  endingBalance    Decimal @map("ending_balance") @db.Decimal(12, 2)

  status CollectionStatus @default(PENDING)

  remarks String? @db.VarChar(255)

  postedAt DateTime? @map("posted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([computationSlipId, collectionDate])
  @@index([computationSlipId])
  @@index([collectionDate])
  @@map("loan_collections")
}

enum CollectionStatus {
  PENDING
  POSTED
  CANCELLED
}

model BranchCounter {
  id String @id @default(uuid()) @db.Uuid

  branchId String @unique @map("branch_id") @db.Uuid

  computationSlipCounter Int @default(0) @map("computation_slip_counter")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("branch_counters")
}

model SupplementaryCollection {
  id String @id @default(uuid()) @db.Uuid

  computationSlipId String @map("computation_slip_id") @db.Uuid

  computationSlip ComputationSlip @relation(fields: [computationSlipId], references: [id], onDelete: Restrict)

  collectionDate DateTime @map("collection_date") @db.Date

  // Actual amount paid in this transaction
  amount Decimal @db.Decimal(12, 2)

  // Supplementary principal balance before payment
  beginningBalance Decimal @map("beginning_balance") @db.Decimal(12, 2)

  // Supplementary principal balance after payment
  endingBalance Decimal @map("ending_balance") @db.Decimal(12, 2)

  // Monthly SL charge computed from supplementary balance
  monthlyCharge Decimal @map("monthly_charge") @db.Decimal(12, 2)

  // Number of chargeable months available at transaction time
  availableChargeMonths Int @map("available_charge_months")

  // Number of months pensioner chose to pay now
  paidChargeMonths Int @map("paid_charge_months")

  // Number of unpaid charge months remaining after this transaction
  remainingChargeMonths Int @map("remaining_charge_months")

  // Total charge due for the selected paid months
  chargeAmount Decimal @map("charge_amount") @db.Decimal(12, 2)

  // Actual portion of payment applied to charge
  chargePaid Decimal @map("charge_paid") @db.Decimal(12, 2)

  // Actual portion applied to supplementary principal
  principalPaid Decimal @map("principal_paid") @db.Decimal(12, 2)

  // charge still unpaid
  remainingCharge Decimal @default(0) @map("remaining_charge") @db.Decimal(12, 2)

  status CollectionStatus @default(PENDING)

  remarks String? @db.VarChar(255)

  postedAt DateTime? @map("posted_at")

  createdAt DateTime @default(now()) @map("created_at")

  updatedAt DateTime @updatedAt @map("updated_at")

  // @@unique([computationSlipId, collectionDate]) //only one supplementary collection can exist per loan account per date.
  @@index([computationSlipId])
  @@index([collectionDate])
  @@map("supplementary_collections")
}
